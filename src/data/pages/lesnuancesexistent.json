77,"h":6,"po":1,"p":[0,9.4,77,6],"t":"text","b":[{"sp":[{"t":"AMINATA DIAKITE","f":"sans","w":400,"s":8.0,"c":"#000000","h":"/","hc":"#00ff26"}],"lh":6,"a":"center"}]},{"id":"17564a","x":96,"y":29.9,"w":133,"h":6,"po":1,"p":[96,29.9,133,6],"t":"text","b":[{"sp":[{"t":"AMINATADIAKITE.CC@GMAIL.COM","f":"sans","w":400,"s":8.0,"c":"#000000","h":"mailto:aminatadiakite.cc@gmail.com","u":true}],"lh":6,"a":"center"}]},{"id":"17564d","x":126,"y":21.9,"w":67,"h":6,"po":1,"p":[126,21.9,67,6],"t":"text","b":[{"sp":[{"t":"ART DIRECTOR","f":"sans","w":400,"s":8.0,"c":"#000000"}],"lh":6,"a":"center"}]},{"id":"17564e","x":142,"y":9.4,"w":31,"h":6,"po":1,"p":[142,9.4,31,6],"t":"text","b":[{"sp":[{"t":"©2023","f":"sans","w":400,"s":8.0,"c":"#000000"}],"lh":6,"a":"center"}]},{"id":"175654","x":77.7,"y":16.4,"w":76.0,"h":6,"p":null,"t":"text","b":[{"sp":[{"t":"BLOG (dans ma tête)","f":"sans","w":400,"s":8.0,"c":"#000000","h":"/blogs","u":true}],"lh":6,"a":"center"}]},{"id":"175655","x":67,"y":16.4,"w":15,"h":7,"p":null,"t":"text","b":[{"sp":[{"t":"/","f":"sans","w":400,"s":9.0,"c":"#000000"}],"lh":7,"a":"center"}]},{"id":"175657","x":104,"y":191.5,"w":783.3,"h":294,"p":[17.2,139.9,283.0,378],"t":"text","b":[{"sp":[{"t":"Penser quelque chose aujourd’hui ne veut pas dire devoir le penser toute sa vie.\nOn peut changer d’avis. Évoluer. Ajuster sa pensée avec le temps.\nLa vie n’est pas linéaire.\n\nOn vit dans une époque qui aime les positions claires, tranchées, presque définitives.\nComme s’il fallait absolument choisir un camp et s’y tenir, quoi qu’il arrive.\n\nMais la réalité est souvent plus complexe que ça.\n\nPlusieurs choses peuvent être vraies en même temps.\nOn peut être ferme sur certains principes et plus souple sur d’autres sujets.\n\nÊtre nuancer, c’est refuser de penser en binaire quand la réalité ne l’est pas.\n\nGarder la nuance, c’est aussi accepter de ne pas avoir de réponse immédiate.\nDe prendre le temps.\nDe laisser une idée mûrir avant de la figer.","f":"sans","w":400,"s":12.0}],"lh":14},{"sp":[{"t":"\nLe monde est complexe.\nLes gens sont complexes.\nEt nos propres pensées le sont aussi.\n","f":"sans","w":400,"s":12.0}],"lh":14}],"pb":[{"sp":[{"t":"Penser quelque chose aujourd’hui ne veut pas dire devoir le penser toute sa vie.\nOn peut changer d’avis. Évoluer. Ajuster sa pensée avec le temps.\nLa vie n’est pas linéaire.\n\nOn vit dans une époque qui aime les positions claires, tranchées, presque définitives.\nComme s’il fallait absolument choisir un camp et s’y tenir, quoi qu’il arrive.\n\nMais la réalité est souvent plus complexe que ça.\n\nPlusieurs choses peuvent être vraies en même temps.\nOn peut être ferme sur certains principes et plus souple sur d’autres sujets.\n\nÊtre nuancer, c’est refuser de penser en binaire quand la réalité ne l’est pas.\n\nGarder la nuance, c’est aussi accepter de ne pas avoir de réponse immédiate.\nDe prendre le temps.\nDe laisser une idée mûrir avant de la figer.","f":"serif","w":400,"s":9.0}],"lh":14},{"sp":[{"t":"\nLe monde est complexe.\nLes gens sont complexes.\nEt nos propres pensées le sont aussi.\n","f":"serif","w":400,"s":9.0}],"lh":14}]},{"id":"16d81d","x":459,"y":85.9,"w":94.1,"h":31,"p":[110,59.3,94.1,31],"t":"text","b":[{"sp":[{"t":"Vie","f":"serif","w":500,"s":9.0,"c":"#000000"}],"lh":30,"a":"center"}]},{"id":"f060ec","x":381,"y":98.1,"w":267.9,"h":62,"p":[28,70.8,267.9,62],"t":"text","b":[{"sp":[{"t":"Les nuances existent.","f":"sans","w":700,"s":11.0,"c":"#000000"}],"lh":30,"a":"center"},{"sp":[{"t":"20/01/2026","f":"sans","w":700,"s":9.0,"c":"#000000"}],"lh":30,"a":"center","p":[0,10,0,0]}]},{"id":"0689d7","x":296,"y":6,"w":12,"h":12,"po":1,"p":[296,6,12,12],"menu":1,"t":"icon","bg":"#000000"},{"id":"a54ee1","x":14,"y":-419,"w":291,"h":411,"po":1,"p":[14,-419,291,411],"slide":487,"t":"text","b":[{"sp":[{"t":"WORKS","f":"sans","w":300,"s":38.0,"c":"#000000","h":"/works","hc":"rgba(160,145,160,0.8)"},{"t":" ","f":"sans","w":300,"s":57.0,"c":"#000000","h":"/works","hc":"rgba(16